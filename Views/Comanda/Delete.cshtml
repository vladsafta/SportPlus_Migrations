@model Comanda

@{
    ViewData["Title"] = "Ștergere Comandă";
}

<h1>Ștergere Comandă</h1>

<h3>Sigur vrei să ștergi comanda cu ID-ul @Model.ComandaId?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">User</dt>
        <dd class="col-sm-10">@Model.User?.Nume</dd>

        <dt class="col-sm-2">Data</dt>
        <dd class="col-sm-10">@Model.DataComanda</dd>

        <dt class="col-sm-2">Preț Total</dt>
        <dd class="col-sm-10">@Model.PretTotal</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed">
    <input type="hidden" asp-for="ComandaId" />
    <button type="submit" class="btn btn-danger">Șterge</button>
    <a asp-action="Index" class="btn btn-secondary">Renunță</a>
</form>