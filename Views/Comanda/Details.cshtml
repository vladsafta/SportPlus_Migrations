@model Comanda

@{
    ViewData["Title"] = "Detalii Comandă";
}

<h1>Detalii Comandă</h1>

<div>
    <h4>Comanda #@Model.ComandaId</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">User</dt>
        <dd class="col-sm-10">@Model.User?.Nume</dd>

        <dt class="col-sm-2">Data</dt>
        <dd class="col-sm-10">@Model.DataComanda</dd>

        <dt class="col-sm-2">Preț Total</dt>
        <dd class="col-sm-10">@Model.PretTotal</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.ComandaId" class="btn btn-warning">Editare</a>
    <a asp-action="Index" class="btn btn-secondary">Înapoi</a>
</div>