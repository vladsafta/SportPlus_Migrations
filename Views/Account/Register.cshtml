@model RegisterViewModel

@{
    ViewData["Title"] = "Autentificare";
    ViewData["MetaRobots"] = "noindex,nofollow";
}


<div class="container mt-5" style="max-width: 500px;">
    <h2 class="text-center mb-4">Creează un cont</h2>

    <form asp-action="Register" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label asp-for="Nume" class="form-label"></label>
            <input asp-for="Nume" class="form-control" />
            <span asp-validation-for="Nume" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Parola" class="form-label"></label>
            <input asp-for="Parola" type="password" class="form-control" />
            <span asp-validation-for="Parola" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Adresa" class="form-label"></label>
            <input asp-for="Adresa" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Telefon" class="form-label"></label>
            <input asp-for="Telefon" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="PozaProfil" class="form-label">Imagine Profil</label>
            <input asp-for="PozaProfil" type="file" class="form-control" />
        </div>

        <button type="submit" class="btn btn-success w-100">Înregistrare</button>
    </form>

    <div class="mt-3 text-center">
        <a asp-action="Login">Ai deja cont? Autentifică-te</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}