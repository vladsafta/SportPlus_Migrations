@{
    ViewData["Title"] = "SportPlus – Articole și Echipamente Sportive";
    ViewData["MetaDescription"] = "SportPlus: produse sportive, echipamente. Descoperă catalogul";
}


<section class="hero-section text-center py-5">
    <h1>Bine ai venit la SportPlus</h1>
    <p>Găsește echipamentele perfecte pentru sportul tău preferat.</p>
    <a asp-controller="Produse" asp-action="Index" class="hero-btn btn btn-primary">Vezi Produse</a>
</section>

<section id="produse" class="container my-5">
    <h2 class="text-center mb-4">Catalog Produse</h2>
    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <img src="~/images/ucl.jpg" class="card-img-top img-fluid" alt="UCL Ball">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">UCL Ball</h5>
                    <p class="card-text">€49.99 EUR</p>
                    <button class="btn btn-primary mt-auto">Cumpără</button>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <img src="~/images/fcb.jpg" class="card-img-top img-fluid" alt="FC Barcelona Home Kit">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">FC Barcelona Home Kit</h5>
                    <p class="card-text">€149.99 EUR</p>
                    <button class="btn btn-primary mt-auto">Cumpără</button>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <img src="~/images/adidasiwc.jpg" class="card-img-top img-fluid" alt="Adidas X Speedportal">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Adidas X Speedportal "Leyenda"</h5>
                    <p class="card-text">€549.99 EUR</p>
                    <button class="btn btn-primary mt-auto">Cumpără</button>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="despre" class="container my-5">
    <h2>Despre Noi</h2>
    <p>Suntem un magazin dedicat pasionaților de sport, oferind produse de cea mai bună calitate.</p>
</section>

<section id="contact" class="container my-5">
    <h2>Contact</h2>
    <p>Email: contact@sportplus.ro</p>
    <p>Telefon: 0712345678</p>
</section>
