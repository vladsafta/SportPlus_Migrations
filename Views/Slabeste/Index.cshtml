@{
    ViewData["Title"] = "Calculator Necesar Caloric";
    ViewData["MetaDescription"] = "Calculator necesar caloric SportPlus: estimează aportul zilnic și obține recomandări pentru slăbit sănătos prin sport și alimentație.";
}


<section class="container my-5">
    <h1 class="text-center">Calculator Necesar Caloric</h1>
    <p class="text-center">Introdu datele tale pentru a calcula câte calorii ai nevoie zilnic.</p>
    
    <div class="calculator-form">
        <label for="gender">Sex:</label>
        <select id="gender" class="form-control">
            <option value="male">Bărbat</option>
            <option value="female">Femeie</option>
        </select>

        <label for="height">Înălțime (cm):</label>
        <input type="number" id="height" class="form-control" placeholder="Ex: 175">

        <label for="weight">Greutate (kg):</label>
        <input type="number" id="weight" class="form-control" placeholder="Ex: 70">

        <label for="activity">Nivel de Activitate:</label>
        <select id="activity" class="form-control">
            <option value="1.2">Sedentar (fără activitate fizică)</option>
            <option value="1.375">Moderată (1-3 antrenamente/săpt.)</option>
            <option value="1.55">Intensă (4-7 antrenamente/săpt.)</option>
        </select>

        <button class="btn btn-primary mt-3" onclick="calculateCalories()">Calculează</button>
        <p id="result" class="mt-3 text-center"></p>
    </div>
</section>

@section Scripts {
    <script>
        function calculateCalories() {
            const gender = document.getElementById("gender").value;
            const height = parseFloat(document.getElementById("height").value);
            const weight = parseFloat(document.getElementById("weight").value);
            const activity = parseFloat(document.getElementById("activity").value);

            if (isNaN(height) || isNaN(weight)) {
                document.getElementById("result").innerText = "Te rugăm să completezi toate câmpurile.";
                return;
            }

            let bmr;
            if (gender === "male") {
                bmr = 10 * weight + 6.25 * height - 5 * 25 + 5; // presupunem vârsta 25
            } else {
                bmr = 10 * weight + 6.25 * height - 5 * 25 - 161;
            }

            const calories = Math.round(bmr * activity);
            document.getElementById("result").innerText = `Ai nevoie de aproximativ ${calories} calorii pe zi.`;
        }
    </script>
}
