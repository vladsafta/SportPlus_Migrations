@model User

@{
    ViewData["Title"] = "Contul meu";
    ViewData["MetaRobots"] = "noindex,nofollow";
}


<div class="container mt-5">
    <h2 class="text-center">Bun venit, @Model.Nume!</h2>

    <div class="row mt-4 justify-content-center">
        <div class="col-md-4 text-center">
            <img src="~/images/users/@Model.PozaProfil"
                 class="rounded-circle img-fluid"
                 style="width: 150px; height: 150px; object-fit: cover;"
                 alt="Poza de profil" />
        </div>

        <div class="col-md-6">
            <div class="card p-4 shadow">
                <p><strong>Email:</strong> @Model.Email</p>
                <p><strong>Adresă:</strong> @Model.Adresa</p>
                <p><strong>Telefon:</strong> @Model.Telefon</p>
                <p><strong>Rol:</strong> @Model.Rol</p>
            </div>
        </div>
    </div>

    <div class="text-center mt-4">
        <form asp-controller="Account" asp-action="Logout" method="post" class="mt-3">
            <button type="submit" class="btn btn-danger">Logout</button>
        </form>
    </div>
</div>