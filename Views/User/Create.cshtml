@model User

@{
    ViewData["Title"] = "Adaugă Utilizator";
}

<h1>Adaugă Utilizator</h1>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="Nume"></label>
        <input asp-for="Nume" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Parola"></label>
        <input asp-for="Parola" class="form-control" type="password" />
    </div>
    <div class="form-group">
        <label asp-for="Adresa"></label>
        <input asp-for="Adresa" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Telefon"></label>
        <input asp-for="Telefon" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Salvează</button>
</form>